---
import type { Dictionary } from "@/i18n/config";
import { contact } from "@/lib/site-config";

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-blue-kimono text-white/80">
  <div class="mx-auto max-w-5xl px-4 py-8 text-sm">
    <p class="font-semibold text-white">{dict.site.name}</p>
    <p class="mt-1">{dict.footer.affiliation}</p>

    <div class="mt-4 flex flex-wrap gap-x-6 gap-y-1">
      <a href={`https://wa.me/${contact.whatsappNumber}`} class="hover:text-white">
        {contact.whatsappDisplay}
      </a>
      <a href={contact.instagramUrl} class="hover:text-white">
        {dict.footer.instagram} {contact.instagramHandle}
      </a>
    </div>

    <p class="mt-4 text-white/50">
      &copy; {year} {dict.site.name} — {dict.footer.rights}
    </p>
  </div>
</footer>
