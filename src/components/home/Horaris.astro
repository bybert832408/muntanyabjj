---
import type { Dictionary } from "@/i18n/config";
import { schedule } from "@/lib/site-config";

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

<section class="border-b border-black/5 bg-offwhite">
  <div class="mx-auto max-w-5xl px-4 py-16">
    <h2 class="text-2xl font-bold text-ink sm:text-3xl">{dict.home.horaris.heading}</h2>
    <p class="mt-2 text-sm text-ink/60">{dict.home.horaris.note}</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      {schedule.map((day) => (
        <div class="rounded-2xl border border-black/10 bg-white p-6">
          <h3 class="font-semibold text-ink">{dict.home.horaris.days[day.day]}</h3>
          <ul class="mt-3 space-y-2 text-sm">
            {day.sessions.map((session) => (
              <li
                class={
                  session.type === "bjjKids"
                    ? "rounded-lg bg-yellow-kids px-3 py-2 font-semibold text-ink"
                    : "rounded-lg bg-blue-logo/10 px-3 py-2 text-ink/80"
                }
              >
                {session.time} — {dict.home.horaris.sessionTypes[session.type]}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
