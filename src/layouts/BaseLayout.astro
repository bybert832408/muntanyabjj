---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getDictionary, type Locale } from "@/i18n/config";
import { assetPath } from "@/lib/asset-path";

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  ogImage?: string;
}

const { lang, title, description, ogImage } = Astro.props;
const dict = getDictionary(lang);
const resolvedDescription = description ?? dict.site.tagline;
const resolvedOgImage = assetPath(ogImage ?? "/images/logo.png");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={resolvedDescription} />
    <link rel="icon" href={assetPath("/favicon.ico")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@700;800&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:image" content={resolvedOgImage} />
  </head>
  <body class="bg-offwhite text-ink antialiased">
    <Header lang={lang} dict={dict} />
    <main>
      <slot />
    </main>
    <Footer dict={dict} />
  </body>
</html>
