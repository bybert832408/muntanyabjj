---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getDictionary, locales, defaultLocale, type Locale } from "@/i18n/config";
import { assetPath } from "@/lib/asset-path";
import { SITE_URL, CONTACT_EMAIL } from "@/config/site";
import { contact, location, schedule } from "@/lib/site-config";

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  ogImage?: string;
  /** Ruta sin el segmento de idioma, ej. "" (home), "tarifes/", "camps/2026/". */
  path?: string;
  /** Inyecta el JSON-LD de Schema.org (solo hace falta en la home). */
  schema?: boolean;
}

const { lang, title, description, ogImage, path = "", schema = false } = Astro.props;
const dict = getDictionary(lang);
const resolvedDescription = description ?? dict.site.tagline;
const resolvedOgImage = assetPath(ogImage ?? "/images/logo.png");
const absoluteOgImage = `${SITE_URL}${resolvedOgImage}`;
const canonicalUrl = `${SITE_URL}/${lang}/${path}`;

const scheduleDayNames: Record<string, string> = {
  mon: "Monday",
  wed: "Wednesday",
  fri: "Friday",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SportsActivityLocation",
  name: dict.site.name,
  description: dict.site.tagline,
  telephone: contact.whatsappDisplay,
  email: CONTACT_EMAIL,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Sort",
    addressRegion: "Pallars Sobirà",
    addressCountry: "ES",
    streetAddress: location.name,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: location.lat,
    longitude: location.lon,
  },
  url: SITE_URL,
  sameAs: [contact.instagramUrl],
  openingHoursSpecification: schedule.flatMap((day) =>
    day.sessions.map((session) => ({
      "@type": "OpeningHoursSpecification",
      dayOfWeek: `https://schema.org/${scheduleDayNames[day.day]}`,
      opens: session.time,
    }))
  ),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={resolvedDescription} />
    <link rel="icon" href={assetPath("/favicon.ico")} />
    <link rel="canonical" href={canonicalUrl} />
    {locales.map((locale) => (
      <link rel="alternate" hreflang={locale} href={`${SITE_URL}/${locale}/${path}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}/${defaultLocale}/${path}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@700;800&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    {schema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="bg-offwhite text-ink antialiased">
    <Header lang={lang} dict={dict} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} dict={dict} />
  </body>
</html>
