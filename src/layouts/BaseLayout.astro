---
import "@/styles/global.css";
import type { Locale } from "@/i18n/config";

interface Props {
  lang: Locale;
  title: string;
}

const { lang, title } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-offwhite text-ink antialiased">
    <slot />
  </body>
</html>
