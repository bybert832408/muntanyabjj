---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ComingSoon from "@/components/ComingSoon.astro";
import { locales, getDictionary, type Locale } from "@/i18n/config";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const dict = getDictionary(lang);
const { botiga } = dict;
---

<BaseLayout lang={lang} title={`${botiga.heading} · ${dict.site.name}`}>
  <ComingSoon heading={botiga.heading} intro={botiga.intro} comingSoon={botiga.comingSoon} />
</BaseLayout>
