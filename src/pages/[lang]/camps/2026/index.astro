---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { locales, getDictionary, type Locale } from "@/i18n/config";
import { assetPath } from "@/lib/asset-path";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const dict = getDictionary(lang);
const { camps } = dict;
const { camp2026 } = camps;
const { detail } = camp2026;

const galleryPlaceholders = Array.from({ length: 8 });
const srcset = [
  `${assetPath("/images/camp-2026-480.webp")} 480w`,
  `${assetPath("/images/camp-2026-800.webp")} 800w`,
  `${assetPath("/images/camp-2026-1200.webp")} 1200w`,
].join(", ");
---

<BaseLayout lang={lang} title={`${camp2026.title} · ${dict.site.name}`}>
  <section class="mx-auto max-w-4xl px-4 py-16">
    <a href={assetPath(`/${lang}/camps/`)} class="text-sm font-semibold text-ink/60 transition hover:text-ink">
      {detail.back}
    </a>

    <div class="mt-4 flex flex-wrap items-center gap-3">
      <h1 class="text-3xl font-extrabold text-ink sm:text-4xl">{camp2026.title}</h1>
      <span class="rounded-full bg-black/5 px-3 py-1 text-xs font-semibold text-ink/60">
        {camp2026.badge}
      </span>
    </div>
    <p class="mt-2 text-ink/70">{detail.subtitle}</p>

    <picture>
      <source type="image/webp" srcset={srcset} sizes="(min-width: 768px) 500px, 90vw" />
      <img
        src={assetPath("/images/camp-2026-1200.jpg")}
        alt={detail.posterAlt}
        width="1200"
        height="1612"
        loading="lazy"
        class="mx-auto mt-8 w-full max-w-md rounded-2xl border border-black/10 shadow-sm"
      />
    </picture>

    <p class="mt-8 max-w-2xl text-ink/70">{detail.story}</p>

    <div class="mt-12">
      <h2 class="text-xl font-bold text-ink">{detail.galleryHeading}</h2>
      <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {galleryPlaceholders.map(() => (
          <div class="flex aspect-square items-center justify-center rounded-xl border border-dashed border-black/15 bg-black/5">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              class="h-8 w-8 text-ink/25"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="18" height="18" rx="2" />
              <circle cx="8.5" cy="8.5" r="1.5" />
              <path d="M21 15l-5-5L5 21" />
            </svg>
          </div>
        ))}
      </div>
      <p class="mt-4 text-sm text-ink/50">{detail.galleryNote}</p>
    </div>
  </section>
</BaseLayout>
