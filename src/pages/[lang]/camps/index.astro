---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { locales, getDictionary, type Locale } from "@/i18n/config";
import { assetPath } from "@/lib/asset-path";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const dict = getDictionary(lang);
const { camps } = dict;
---

<BaseLayout lang={lang} title={`${camps.heading} · ${dict.site.name}`}>
  <section class="mx-auto max-w-5xl px-4 py-16">
    <h1 class="text-3xl font-extrabold text-ink sm:text-4xl">{camps.heading}</h1>
    <p class="mt-3 max-w-2xl text-ink/70">{camps.intro}</p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      <a
        href={assetPath(`/${lang}/camps/2026/`)}
        class="overflow-hidden rounded-2xl border border-black/10 bg-white shadow-sm transition hover:border-black/20 hover:shadow-md"
      >
        <div class="h-1.5 bg-black/10" />
        <div class="p-6">
          <div class="flex items-center justify-between gap-3">
            <p class="font-semibold text-ink">{camps.camp2026.title}</p>
            <span class="rounded-full bg-black/5 px-3 py-1 text-xs font-semibold text-ink/60">
              {camps.camp2026.badge}
            </span>
          </div>
          <p class="mt-3 text-sm text-ink/70">{camps.camp2026.body}</p>
        </div>
      </a>

      <div class="overflow-hidden rounded-2xl border border-black/10 bg-white shadow-sm">
        <div class="h-1.5 bg-blue-logo" />
        <div class="p-6">
          <div class="flex items-center justify-between gap-3">
            <p class="font-semibold text-ink">{camps.camp2027.title}</p>
            <span class="rounded-full bg-blue-logo px-3 py-1 text-xs font-semibold text-ink">
              {camps.camp2027.badge}
            </span>
          </div>
          <p class="mt-3 text-sm text-ink/70">{camps.camp2027.body}</p>
          <a
            href={assetPath(`/${lang}/apuntat/`)}
            class="mt-5 inline-block rounded-full bg-blue-logo px-5 py-2 text-sm font-semibold text-ink transition hover:brightness-110"
          >
            {camps.camp2027.cta}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
