---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/home/Hero.astro";
import Escola from "@/components/home/Escola.astro";
import Instructor from "@/components/home/Instructor.astro";
import Horaris from "@/components/home/Horaris.astro";
import Galeria from "@/components/home/Galeria.astro";
import Ubicacio from "@/components/home/Ubicacio.astro";
import { locales, getDictionary, type Locale } from "@/i18n/config";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const dict = getDictionary(lang);
---

<BaseLayout lang={lang} title={`${dict.site.name} — ${dict.site.tagline}`}>
  <Hero lang={lang} dict={dict} />
  <Escola dict={dict} />
  <Instructor dict={dict} />
  <Horaris dict={dict} />
  <Galeria dict={dict} />
  <Ubicacio dict={dict} />
</BaseLayout>
