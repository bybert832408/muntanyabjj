---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { locales, getDictionary, type Locale } from "@/i18n/config";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const dict = getDictionary(lang);
---

<BaseLayout lang={lang} title={`${dict.site.name} — ${dict.site.tagline}`}>
  <main class="flex min-h-screen flex-col items-center justify-center gap-6 px-6 text-center">
    <h1 class="font-bold text-3xl text-blue-kimono sm:text-5xl">{dict.site.name}</h1>
    <p class="text-ink">{dict.site.tagline}</p>

    <nav class="flex gap-4" aria-label="Selector d'idioma">
      {
        locales.map((l) => (
          <a
            href={`${import.meta.env.BASE_URL}${l}/`}
            class={`rounded px-3 py-1 ${
              l === lang ? "bg-blue-kimono text-offwhite" : "bg-offwhite text-ink underline"
            }`}
            aria-current={l === lang ? "page" : undefined}
          >
            {l.toUpperCase()}
          </a>
        ))
      }
    </nav>
  </main>
</BaseLayout>
